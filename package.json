{
  "name": "@local/dsh-notify-hub",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-channel DSH notifications: WeCom, Telegram, ServerChan, Feishu, DingTalk, Bark, ntfy, Discord, Slack, PushPlus, Gotify and webhooks.",
  "type": "module",
  "scripts": { "test": "node --test" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "channels.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
